{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@medical/global": [
        "../../packages/global/src"
      ],
      "@medical/global/*": [
        "../../packages/global/src/*"
      ],
      "@medical/service": [
        "../../packages/service/src"
      ],
      "@medical/service/*": [
        "../../packages/service/src/*"
      ],
      "@medical/web": [
        "../../packages/web/src"
      ],
      "@medical/web/*": [
        "../../packages/web/src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
