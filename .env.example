# ========================================
# 医疗动态问诊平台 - 环境变量模板
# 复制为 .env 并填入实际值
# ========================================

# ---- 运行模式 ----
STORAGE_MODE=local              # local | minio
QUEUE_MODE=direct               # direct | redis
OCR_MODE=local                  # local | docker | none

# ---- 数据库 ----
# 本地 MongoDB 或 MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/medical_platform

# ---- Redis (QUEUE_MODE=direct 时不需要) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- AI 模型 (至少填一个) ----
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DEFAULT_MODEL=deepseek-chat

# ---- 企业微信 (可选) ----
WXWORK_CORP_ID=ww_your_corp_id
WXWORK_AGENT_ID=1000002
WXWORK_SECRET=your_agent_secret

# ---- 应用 ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=医疗智能问诊平台
